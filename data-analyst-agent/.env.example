# This service's own Postgres — never the existing Node app's Neon database.
# Local dev: postgresql+asyncpg://localhost/data_analyst_agent
# docker-compose (see docker-compose.yml's `db` service, hostname `db`):
DATABASE_URL=postgresql+asyncpg://data_analyst_agent:${POSTGRES_PASSWORD}@db:5432/data_analyst_agent

# Only used by docker-compose.yml's `db` service.
POSTGRES_PASSWORD=

# Public domain this service is served on (Traefik router rule in docker-compose.yml).
# Not currently used — deployed instances are reverse-proxied through the
# main Node app's own domain instead (see ROOT_PATH below); this is left in
# place only in case direct subdomain access is wanted later.
DATA_ANALYST_AGENT_DOMAIN=analyst.zunkireelabs.com

# Path prefix this service is reverse-proxied under by the main Node app
# (server/routes/data-agent.js there). Leave unset for local dev, running
# uvicorn directly with nothing in front — only set this in the deployed
# .env, matching that proxy's mount path.
ROOT_PATH=/data-agent

# Fernet key used to encrypt/decrypt clients.mcp_token_ciphertext. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Base URL of the existing Node app's MCP endpoint (this service's only data interface).
MCP_BASE_URL=https://your-analytics-app.example.com/api/mcp

# Static admin API key this service's own /dashboard and /ask routes require.
ADMIN_API_KEY=



# In-process nightly ingestion cron (app/ingestion/scheduler.py). Runs
# run_nightly() for every active client on a schedule, so ingestion no longer
# requires manually exec'ing into the container. Set to false only if you're
# deliberately driving ingestion some other way (e.g. an external scheduler).
INGEST_SCHEDULE_ENABLED=true
INGEST_SCHEDULE_HOUR_UTC=3

# In-process nightly ANALYSIS cron (app/analysis/run_pass.py, scheduled from
# the same app/ingestion/scheduler.py): stats -> anomalies -> forecasts ->
# insights -> recommendations. This used to run only from a host-level crontab
# line that docker-compose.yml documents but nothing installs, so on a fresh
# deploy no forecast was ever generated. Runs an hour after ingestion so that
# day's observations are already written. Set to false only if you're driving
# the analysis pass some other way (e.g. scripts/run_analysis_pass.py by hand).
ANALYSIS_SCHEDULE_ENABLED=true
ANALYSIS_SCHEDULE_HOUR_UTC=4

# Ingestion / stats / forecast tuning (see Part A/B of the plan for rationale).
INGEST_LOOKBACK_DAYS=400
Z_SCORE_THRESHOLD=3.0
IQR_MULTIPLIER=1.5
FORECAST_HORIZON_DAYS=14
MIN_HISTORY_DAYS_FOR_FORECAST=30
