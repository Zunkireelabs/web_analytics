# Same Neon Postgres DB the rest of the app uses (sites/gsc_breakdown live
# there per server/migrations/001_init.sql).
DATABASE_URL=postgresql://user:password@host/dbname

# LLM provider auto-selects exactly like server/llm.js's own pickProvider():
# a real OPENAI_API_KEY present -> OpenAI, else Anthropic. Only one is
# required, whichever the provider resolves to.
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# CLUSTERING_LLM_PROVIDER=openai
# CLUSTERING_LLM_MODEL=gpt-4o-mini
