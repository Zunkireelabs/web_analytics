From 3bd0b09e14d003e529283ba182de896c8fc39470 Mon Sep 17 00:00:00 2001
From: Zennly CI proposal <noreply@example.invalid>
Date: Thu, 26 Nov 2026 13:00:06 +0545
Subject: [PATCH] Regenerate the Next /businesses pages from the Eleventy
 sources on pull requests

---
 .github/scripts/regen-pages.sh            |  63 +++++++++++
 .github/workflows/generate-blog-pages.yml | 121 ++++++++++++++++++++++
 2 files changed, 184 insertions(+)
 create mode 100755 .github/scripts/regen-pages.sh
 create mode 100644 .github/workflows/generate-blog-pages.yml

diff --git a/.github/scripts/regen-pages.sh b/.github/scripts/regen-pages.sh
new file mode 100755
index 0000000..9f1f623
--- /dev/null
+++ b/.github/scripts/regen-pages.sh
@@ -0,0 +1,63 @@
+#!/usr/bin/env bash
+# PROPOSED FOR ZENNLY'S REPO (Zunkireelabs/zennly-marketplace), next to the workflow. NOT INSTALLED ANYWHERE. Install at .github/scripts/regen-pages.sh (executable).
+#
+# Decides which /businesses pages a pull request's Eleventy source changes affect, so the workflow re-ports exactly those and nothing else.
+#   regen-pages.sh candidates   (before the build)  prints one mirror path per line, derived from the files the PR changed vs $BASE_SHA
+#   regen-pages.sh final        (after the build)   reads candidates on stdin; keeps those that really are mirrored pages; skips the hand-ported pilots
+#   regen-pages.sh verify       (after the build)   reads the final list on stdin; fails if the build changed any mirrored page that is NOT in that list
+# Page paths are the ones scripts/port-businesses-pages.py takes: 'about', 'blog', 'blog/<slug>', 'features/<x>' ...
+set -euo pipefail
+
+# Hand-ported pilots (ALREADY in scripts/port-businesses-pages.py): their Next page is written by hand, so the converter must not touch them.
+HAND_PORTED_RE='^(blog/spa-booking-app-nepal)?$'
+SAFE_RE='^[a-z0-9][a-z0-9/_-]*$'
+
+mode="${1:?usage: regen-pages.sh candidates|final|verify}"
+
+case "$mode" in
+  candidates)
+    : "${BASE_SHA:?BASE_SHA is required}"
+    files=$(git diff --name-only --diff-filter=AM "$BASE_SHA" HEAD -- 'marketing/src/*.njk' 'marketing/src/**/*.njk' 'marketing/src/_data/blogOrder.json' | sort -u)
+    out=""
+    while IFS= read -r f; do
+      [ -z "$f" ] && continue
+      case "$f" in
+        marketing/src/_data/blogOrder.json) out+=$'blog\n' ;;
+        marketing/src/_includes/*|marketing/src/_data/*) echo "::warning::Shared file $f changed: it can affect many pages and is not regenerated automatically." >&2 ;;
+        *.njk)
+          p="${f#marketing/src/}"; p="${p%.njk}"
+          [ "$p" = "index" ] && p=""
+          out+="$p"$'\n'
+          case "$p" in blog/*) out+=$'blog\n' ;; esac ;;
+      esac
+    done <<< "$files"
+    printf '%s' "$out" | sort -u | { grep -v '^$' || true; } | while IFS= read -r p; do
+      if ! printf '%s' "$p" | grep -Eq "$SAFE_RE"; then echo "::error::Unexpected page path: $p" >&2; exit 1; fi
+      printf '%s\n' "$p"
+    done
+    # the home page maps to the empty path: report it so it is not lost silently
+    if printf '%s' "$out" | grep -qx ''; then echo "::warning::The home page source changed: its Next page is hand-ported and must be updated by hand." >&2; fi
+    ;;
+  final)
+    while IFS= read -r p; do
+      [ -z "$p" ] && continue
+      if printf '%s' "$p" | grep -Eq "$HAND_PORTED_RE"; then echo "::warning::/businesses/$p is hand-ported: its Next page must be updated by hand; skipped." >&2; continue; fi
+      if [ ! -f "public/businesses/$p/index.html" ]; then echo "::notice::$p is not a mirrored page (no public/businesses/$p/index.html); skipped." >&2; continue; fi
+      printf '%s\n' "$p"
+    done
+    ;;
+  verify)
+    expected=$(cat)
+    changed=$(git ls-files --modified --others --exclude-standard -- public/businesses | grep -E '/index\.html$' | sed -E 's#^public/businesses/##; s#/?index\.html$##' | sort -u)
+    bad=""
+    while IFS= read -r c; do
+      [ -z "$c" ] && continue
+      # a hand-ported page's mirrored copy changes whenever its source does (it is only the rollback copy): expected, not drift
+      if printf '%s' "$c" | grep -Eq "$HAND_PORTED_RE"; then continue; fi
+      printf '%s\n' "$expected" | grep -qxF -- "$c" || bad+="$c"$'\n'
+    done <<< "$changed"
+    if [ -n "$bad" ]; then echo "::error::The build changed mirrored pages this pull request does not account for (unrelated drift, or a shared file changed):"; printf '%s' "$bad"; exit 1; fi
+    echo "Every changed mirrored page is accounted for."
+    ;;
+  *) echo "unknown mode: $mode" >&2; exit 2 ;;
+esac
diff --git a/.github/workflows/generate-blog-pages.yml b/.github/workflows/generate-blog-pages.yml
new file mode 100644
index 0000000..26a3624
--- /dev/null
+++ b/.github/workflows/generate-blog-pages.yml
@@ -0,0 +1,121 @@
+# PROPOSED FOR ZENNLY'S REPO (Zunkireelabs/zennly-marketplace). NOT INSTALLED ANYWHERE. Owner-approved copy goes to .github/workflows/generate-blog-pages.yml, together with
+# .github/scripts/regen-pages.sh (the same folder as this file).
+#
+# Why: a /businesses page (a blog post, a legal page, a feature page ...) is only live when its generated Next.js pages match its Eleventy source. Those pages are produced by the
+# repo's OWN scripts (scripts/sync-businesses-site.mjs builds the Eleventy marketing site and mirrors it into public/businesses; scripts/port-businesses-pages.py turns the mirrored
+# pages into src/app/... page.tsx + src/components/marketing/pages/generated/*.ts + the src/lib/businesses-ported.ts entry). Nothing runs them automatically today, so an edit to a
+# source page (a new blog post, internal links, breadcrumbs, an FAQ) would never reach the live site.
+# This job runs exactly those scripts on a pull request that adds or changes a source page, and commits ONLY their output back to the PR branch. A person still reviews and
+# merges the PR; nothing is deployed from here.
+#
+# Safety:
+#  - same-repository branches only (never a fork), never for the bot's own commits;
+#  - the job's token can write repository contents and nothing else; no secrets are used;
+#  - actions are pinned to full commit SHAs;
+#  - which pages to regenerate is worked out from the files the PR changed (regen-pages.sh); the two hand-ported pages are never touched;
+#  - after the build, any mirrored page that changed but is not accounted for fails the job (unrelated drift or a shared file) instead of being committed;
+#  - only generated /businesses paths are staged; any other changed file fails the job;
+#  - the build fails (and the PR shows it) if a post is missing from marketing/src/_data/blogOrder.json, the repo's own drift check.
+name: Generate Next pages from Eleventy sources
+
+on:
+  pull_request:
+    types: [opened, synchronize, reopened]
+    paths:
+      - 'marketing/src/*.njk'
+      - 'marketing/src/**/*.njk'
+      - 'marketing/src/_data/blogOrder.json'
+
+permissions:
+  contents: write
+
+concurrency:
+  group: generate-pages-${{ github.event.pull_request.number }}
+  cancel-in-progress: true
+
+jobs:
+  generate:
+    name: Regenerate the Next pages for the changed source pages
+    if: github.event.pull_request.head.repo.full_name == github.repository && github.actor != 'github-actions[bot]'
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    env:
+      BASE_SHA: ${{ github.event.pull_request.base.sha }}
+      HEAD_REF: ${{ github.event.pull_request.head.ref }}
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          ref: ${{ github.event.pull_request.head.ref }}
+          fetch-depth: 0
+
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
+        with:
+          node-version: 22
+          cache: npm
+
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
+        with:
+          python-version: '3.12'
+
+      # Same install the repo's own CI uses (npm install, not npm ci: the lockfile resolves differently on this runner), without lifecycle scripts:
+      # the marketing build needs no prisma/maplibre postinstall.
+      - name: Install dependencies
+        run: npm install --ignore-scripts --no-audit --no-fund
+
+      - name: Work out which pages this pull request changes
+        id: pages
+        run: |
+          set -euo pipefail
+          candidates=$(bash .github/scripts/regen-pages.sh candidates)
+          echo "Candidate pages: ${candidates:-none}"
+          {
+            echo 'candidates<<EOF'
+            printf '%s\n' "$candidates"
+            echo 'EOF'
+          } >> "$GITHUB_OUTPUT"
+
+      # The repo's own build + mirror. Fails if a post file is missing from blogOrder.json.
+      - name: Build the marketing site and mirror it into public/businesses
+        run: node scripts/sync-businesses-site.mjs
+
+      - name: Keep the real mirrored pages, skip the hand-ported ones
+        id: final
+        env:
+          CANDIDATES: ${{ steps.pages.outputs.candidates }}
+        run: |
+          set -euo pipefail
+          final=$(printf '%s\n' "$CANDIDATES" | bash .github/scripts/regen-pages.sh final)
+          printf '%s\n' "$final" | bash .github/scripts/regen-pages.sh verify
+          echo "Pages to regenerate: ${final:-none}"
+          {
+            echo 'final<<EOF'
+            printf '%s\n' "$final"
+            echo 'EOF'
+          } >> "$GITHUB_OUTPUT"
+
+      # The repo's own converter.
+      - name: Generate the Next pages
+        env:
+          FINAL: ${{ steps.final.outputs.final }}
+        run: |
+          set -euo pipefail
+          args=()
+          while IFS= read -r p; do [ -n "$p" ] && args+=("$p"); done <<< "$FINAL"
+          if [ "${#args[@]}" -eq 0 ]; then echo "Nothing to generate."; exit 0; fi
+          python3 scripts/port-businesses-pages.py "${args[@]}"
+
+      - name: Commit the generated files to the pull request branch
+        run: |
+          set -euo pipefail
+          git checkout -- package-lock.json 2>/dev/null || true
+          allowed='^(public/businesses/|src/app/\(marketing-[^/]+\)/businesses/|src/components/marketing/pages/generated/[^/]+\.ts$|src/lib/businesses-ported\.ts$)'
+          unexpected=$(git ls-files --modified --others --exclude-standard | grep -Ev "$allowed" || true)
+          if [ -n "$unexpected" ]; then
+            echo "::error::The scripts changed files outside the generated /businesses paths; refusing to commit them:"; echo "$unexpected"; exit 1
+          fi
+          git add -A -- public/businesses src/app src/components/marketing/pages/generated src/lib/businesses-ported.ts
+          if git diff --cached --quiet; then echo "Generated pages are already up to date."; exit 0; fi
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git commit -m "Regenerate Next pages from the Eleventy sources (automated)"
+          git push origin "HEAD:${HEAD_REF}"
-- 
