# ── Database ───────────────────────────────────────────────────────────────────
# Use the POOLED connection string from Neon (contains "-pooler" in the hostname)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# ── Google credentials ─────────────────────────────────────────────────────────
# Option A (recommended): service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/service-account.json

# Option B (fallback): OAuth2 refresh token from your own Google account
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# ── Google property identifiers ────────────────────────────────────────────────
# GSC: the exact string from Search Console → Settings → Property
#   e.g.  sc-domain:example.com   OR   https://www.example.com/
GSC_PROPERTY=sc-domain:example.com

# GA4: numeric Property ID (GA4 Admin → Property Settings → Property ID)
GA4_PROPERTY_ID=123456789

# ── AI narrative ───────────────────────────────────────────────────────────────
# Primary: Anthropic (Claude). Set ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=sk-ant-...
REPORT_MODEL_DAILY=claude-haiku-4-5-20251001
REPORT_MODEL_MONTHLY=claude-opus-4-8

# Fallback: OpenAI. Set OPENAI_API_KEY (leave ANTHROPIC_API_KEY blank to use OpenAI).
# OPENAI_API_KEY=sk-proj-...
# REPORT_MODEL_DAILY=gpt-4o-mini
# REPORT_MODEL_MONTHLY=gpt-4o

# ── Email (daily morning report) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
# Use a Gmail App Password (not your account password)
SMTP_PASS=xxxx xxxx xxxx xxxx
REPORT_EMAIL_FROM="Analytics Bot <you@gmail.com>"
REPORT_EMAIL_TO=recipient@example.com
# Catch-all for SYSTEM-INITIATED mail. When set, daily reports, notifications
# and sales leads go to this address instead of their real recipient, with the
# original preserved in the subject and an X-Original-To header. Intended for any environment that runs the live cron
# against real client data — staging sets it; production must leave it unset.
# Invitation and password-reset mail is exempt (see REDIRECT_EXEMPT).
# EMAIL_REDIRECT_TO=you@example.com

# ── Dashboard auth ─────────────────────────────────────────────────────────────
# Logins are per-user now (email + password), not a single shared password.
# Provision one with: npm run create-client -- <email> <password> --site-id <id>
# SESSION_SECRET still signs the session cookie — set it to a strong, unique value.
SESSION_SECRET=change-me-random-64-char-string

# The `sites.id` of your own internal site. The AI Growth Platform
# (/api/agents*, /api/action-center*, the /ai-growth dashboard page) is
# internal-only and is hidden (404) for every other site/client.
COMPANY_SITE_ID=1

# ── Site identity ──────────────────────────────────────────────────────────────
SITE_NAME=My Website
# Timezone for the cron schedule and "yesterday" calculations.
# Must match the timezone of your GA4 property.
TZ=Asia/Kolkata

# ── Cron schedule ──────────────────────────────────────────────────────────────
# The DETECTION half of the day: ingest + email + run the agents and fill the
# recommendations table. Deliberately early, so it runs once GSC's data for the
# target dates is final. It does NOT ship anything — see SHIP_CRON_SCHEDULE.
CRON_SCHEDULE=0 7 * * *
# Weekly doc report schedule (optional; leave blank to disable).
# WEEKLY_CRON_SCHEDULE=0 8 * * 1

# ── GitHub App (multi-client credentials) ─────────────────────────────────────
# The way to authenticate a SECOND client's repo without asking them for a
# personal access token. The PAT path above works and is genuinely isolated per
# site, but it does not scale: each tenant needs its own env var (so a new
# Actions secret, a new line in the deploy workflow, and a redeploy — a code
# change per customer), every PAT expires on a date the client controls, and it
# asks people to hand over a long-lived credential to their production website.
#
# With a GitHub App the client clicks "Install" on their own repo instead. No
# credential changes hands, tokens are minted per installation and expire in an
# hour, and the client can revoke it themselves from their own settings.
#
# One-time setup:
#   1. Register a GitHub App (Settings → Developer settings → GitHub Apps).
#      Repository permissions: Contents read/write, Pull requests read/write.
#      Subscribe to the "Installation" and "Installation repositories" events
#      (Webhook section) if you also want installation ids auto-recorded —
#      see GITHUB_APP_WEBHOOK_SECRET below. Not required for the App to work,
#      only for skipping step 5's manual copy-paste.
#   2. Generate a private key. GitHub downloads a .pem.
#   3. Set the two vars below. Base64 is used rather than the raw PEM because
#      the deploy writes .env in one block and a PEM's newlines do not survive
#      that:  base64 -i your-app.private-key.pem | tr -d '\n'
# Per client, thereafter:
#   4. Send them the App's install URL. They install it on their repo.
#   5. Record the installation id GitHub assigns — automatically, if the
#      webhook from step 1 is set up (matched to a site by repo owner/name,
#      server/routes/webhooks.js), otherwise by hand:
#      npm run connect-repo -- --site-id <id> --github-app-installation-id <id>
#      From then on that site authenticates as the App and ignores PATs
#      entirely — no new env var, no redeploy.
#
# A site with no installation id keeps using its PAT, which is every existing
# site and remains fully supported. Note that a site WITH an installation id
# never falls back to a PAT: falling back would mean authenticating one
# tenant's repo with the shared default token.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_B64=
#
# ── Per-client GitHub Apps (migration 154) ─────────────────────────────────
# Every site above authenticates as the ONE App configured by GITHUB_APP_ID —
# fine for a single tenant, but every tenant on it shares that App's single
# 5,000/hr GitHub API rate limit. Found the hard way: sites 1 and 8862, both
# repos under the Zunkireelabs GitHub account, both on installation
# 153416356 — a heavy shipping day for one tenant rate-limited the other's
# PRs into "abandoned" with no quota actually exhausted on the 100/day
# ceiling (server/lib/autonomous-quota.js).
#
# Since GitHub allows only one installation of a given App per account/org,
# repos under YOUR OWN account (not the client's) can't get separate budgets
# by reinstalling the same App — each such client needs a genuinely SEPARATE
# App registration instead:
#   1. Register another GitHub App (same permissions: Contents + Pull
#      requests, read/write) and install it scoped to just that one client's
#      repo.
#   2. Add its private key here under its own name, e.g.:
#        GITHUB_APP_PRIVATE_KEY_B64_ADMIZZ=
#   3. Record both on that site:
#        npm run connect-repo -- --site-id <id> \
#          --github-app-id <the new App's id> \
#          --github-app-private-key-env-var GITHUB_APP_PRIVATE_KEY_B64_ADMIZZ \
#          --github-app-installation-id <its installation id>
#   4. Verify before relying on it: node server/scripts/verify-github-app.js --site-id <id>
#
# The installation-events webhook below (GITHUB_APP_WEBHOOK_SECRET) is
# configured on the SHARED default App only and will not auto-populate a
# newly-registered App's installation id — step 3's manual
# --github-app-installation-id is required for every per-client App, the same
# fallback already documented in step 5 above for an "All repositories"
# install of the default App.
#
# A site with no github_app_id keeps authenticating as the shared default
# App above — this is opt-in per client, not a required migration.

# Secret shared with the GitHub App's own webhook config (the App's Settings
# page → Webhook, NOT a per-repo webhook — GITHUB_WEBHOOK_SECRET below is a
# different secret for a different, per-repo webhook). Verifies inbound
# "installation"/"installation_repositories" events at
# /api/webhooks/github-app (server/routes/webhooks.js), which auto-populate
# or clear a site's github_app_installation_id as clients install/uninstall
# the App or add/remove repos, matching by repo owner/name (case-insensitive)
# against sites.repo_owner/repo_name. Without this set, that route fails
# closed (401) on every request — step 5 above still works by hand.
# GITHUB_APP_WEBHOOK_SECRET=

# ── Design Agent worker ────────────────────────────────────────────────────────
# The design-agent-worker container loads THIS file (docker-compose's
# `env_file: .env`), but the two variables its actual work depends on were only
# ever documented in server/design-agent/python/.env.example — a file nothing
# reads at deploy time. Documented here because that omission is invisible until
# jobs start failing:
#
# server/design-agent/python/design_task.py builds its LLM with
# api_key=os.getenv("LLM_API_KEY"), and does so BEFORE opening the
# DockerWorkspace. With the key unset that resolves to None, so the container
# starts normally and the job only fails once the first model call is made —
# tens of seconds in, with no mention of a missing key in anything that reaches
# the database (worker.js routes the real error through safeMessage, which
# deliberately keeps it out of customer-visible text; the full text is in the
# container's own stdout, keyed by the `ref:` id in the job's log line).
#
# Symptom to match this against: a design_generate job that runs for ~40s and
# then fails with "Design Agent job failed unexpectedly". Verify on the host
# with `docker logs design-agent-worker-stage | grep <ref>`.
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# ── Autonomous shipping ────────────────────────────────────────────────────────
# The SHIPPING half: turn the recommendations detected above into a real branch
# and PR for every opted-in tenant (sites.auto_remediation_enabled), highest
# severity first, bounded by sites.auto_remediation_daily_limit. Split from
# CRON_SCHEDULE on purpose — detection wants to run as soon as data is final,
# shipping wants a predictable hour a human can expect to review a batch at.
# Autonomy ends at an open PR; nothing here ever merges.
# SHIP_HOUR_LOCAL is the hour used both for the default schedule below and for
# the per-site catch-up guard, which recovers a missed run (cron is not a
# reliable trigger on a machine that sleeps).
# SHIP_HOUR_LOCAL=13
# SHIP_CRON_SCHEDULE=0 13 * * *

# Automated design-integrity gate (design-drift.js's checkDesignIntegrityGate,
# migration 133): every styled/net-new draft is checked against its site's
# design profile with verifyProfileRoles before it ships. Defaults to
# LOG-ONLY — every verdict is recorded to design_integrity_verdicts but never
# blocks — so the check's real false-positive/negative rate can be reviewed
# against real, already-derived profiles first. Set to "true" once that
# observation period looks clean; a failing verdict then quarantines only
# that one draft, never the whole site's run.
# DESIGN_INTEGRITY_ENFORCE=false

# ── Competitor intelligence (optional) ───────────────────────────────────────
# Real competitor SERP rankings, checked weekly for this site's own top real
# queries (server/agents/competitor-intelligence.js). Without these set, the
# competitor-intelligence agent reports "insufficient-data" honestly rather
# than fabricating rankings — every other agent keeps working normally.
# Login+password pair from your DataForSEO account dashboard (not a single API key).
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DataForSEO location/language codes for SERP results — defaults to United
# States / English if unset. See DataForSEO's location/language code lists.
# COMPETITOR_LOCATION_CODE=2840
# COMPETITOR_LANGUAGE_CODE=en
# Which adapter in server/ingest/competitor-providers/ to use — defaults to
# dataforseo. Set to google-cse to use the free alternative below instead.
# COMPETITOR_PROVIDER=dataforseo

# Free alternative to DataForSEO for real Google SERP checks: Google's own
# Custom Search JSON API (server/ingest/competitor-providers/google-cse.js) —
# 100 real queries/day free, then paid. Requires a Cloud API key with the
# Custom Search API enabled, plus a Search Engine ID from
# https://programmablesearchengine.google.com/ configured to search the
# entire web (not just your own site). Set COMPETITOR_PROVIDER=google-cse
# above to actually use it once these are set.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# Optional: 2-letter country / language codes (e.g. us / en) — omit to let
# Google use its own defaults.
# GOOGLE_CSE_COUNTRY=
# GOOGLE_CSE_LANGUAGE=
# Opt-in: lets the Content Expansion generator's "external-citations" focus
# (generators/expand-content.js) use Tavily (see TAVILY_API_KEY below) to
# find real source URLs to cite, instead of writing link-free placeholder
# prose. Off by default even with TAVILY_API_KEY set — deliberate separate
# switch, same pattern as AI_RECOMMENDATION_ENABLED etc. This path never
# uses Google CSE or SerpApi (those stay reserved for competitor SERP data
# above) and never falls back to them if Tavily's quota is exhausted.
# ENABLE_CONTENT_CITATION_SEARCH=true

# ── Tavily (optional, real web search / citation grounding) ─────────────────
# API key from your Tavily dashboard (tavily.com). Sole search-grounding
# provider for the Content Expansion generator's "external-citations" focus
# (server/ingest/search-grounding-providers/tavily.js) — also requires
# ENABLE_CONTENT_CITATION_SEARCH=true above to actually activate. Never
# shared with, or a fallback for, Google CSE/SerpApi/DataForSEO above (those
# stay dedicated to real SEO/SERP/keyword-demand intelligence).
# TAVILY_API_KEY=
# Strict internal cap on Tavily queries/day, independent of your Tavily
# account's own plan limits — a second brake so a bug can't run up real
# spend unnoticed. Defaults to 100/day if unset.
# TAVILY_MAX_QUERIES_PER_DAY=100

# ── Technical SEO agent (optional enrichment) ────────────────────────────────
# Core Web Vitals via Google PageSpeed Insights (server/ingest/pagespeed.js).
# Without this set, the technical-seo agent still reports real GSC index
# status, sitemap health, technical page audit, and broken-link/redirect
# findings — Core Web Vitals findings just don't appear, reported honestly as
# insufficient-data for that one sub-check rather than faked. A single API
# key from the Google Cloud Console, not OAuth.
# PAGESPEED_API_KEY=

# ── Authority Agent (optional, real DataForSEO backlink data) ────────────────
# Real backlink profile via DataForSEO's Backlinks API (server/ingest/
# dataforseo-backlinks.js) — reuses the same DATAFORSEO_LOGIN/PASSWORD above,
# no separate credential pair. Without those set, the authority agent
# honestly reports insufficient-data, never a fabricated score.

# ── AI Recommendation Agent (optional, real OpenAI prompt probes) ────────────
# Tests whether ChatGPT actually recommends this company for real buyer-style
# prompts — distinct from the ai-visibility agent (structural readiness only).
# Requires a real OPENAI_API_KEY (same var as REPORT_PROVIDER=openai above)
# AND this separate opt-in flag — deliberately NOT auto-enabled just because
# OPENAI_API_KEY happens to be set for the daily-narrative feature, since
# this agent makes real, costed probe calls per tracked prompt and shouldn't
# silently activate for a key configured for something else.
# AI_RECOMMENDATION_ENABLED=true
# Which OpenAI model probes real prompts — defaults to gpt-4o-mini.
# AI_RECOMMENDATION_MODEL=gpt-4o-mini
# How many real prompts get probed per run — defaults to 15 (today's
# hardcoded batch size). Turning on additional providers below multiplies
# real probe+extract calls per run (batchSize × providerCount × 2); lower
# this if enabling more than one provider to keep spend in check.
# AI_RECOMMENDATION_BATCH_SIZE=15
#
# Additional providers (all optional, all independently gated — enabling
# one never enables another). Each still requires the master
# AI_RECOMMENDATION_ENABLED=true flag above, PLUS its own real API key AND
# its own dedicated enable flag, same double-gate reasoning as OpenAI's.
# Leave unset to keep probing OpenAI-only, exactly today's behavior.
# ANTHROPIC_API_KEY=sk-ant-...  (same var as REPORT_PROVIDER=anthropic above)
# AI_RECOMMENDATION_ANTHROPIC_ENABLED=true
# AI_RECOMMENDATION_ANTHROPIC_MODEL=claude-haiku-4-5
# PERPLEXITY_API_KEY=pplx-...
# AI_RECOMMENDATION_PERPLEXITY_ENABLED=true
# AI_RECOMMENDATION_PERPLEXITY_MODEL=sonar
#
# How often this agent actually does real work — defaults to 'month'
# (today's behavior, checked via the weekly cron poll but only acting once a
# real calendar month has passed). Set to 'week' to run weekly instead — NOTE
# this multiplies real API spend (~4.3x) on top of however many providers
# above are enabled; a genuinely separate decision from turning on a new
# provider, left off by default.
# AI_RECOMMENDATION_CADENCE=month

# ── Agentic Orchestration (optional, multi-round LLM tool-calling) ───────────
# Lets the LLM itself decide, via real OpenAI tool calls, which specialist
# agents are worth invoking for a given Copilot question or Action Center
# refresh — instead of always running a fixed agent list. Requires a real
# OPENAI_API_KEY (same var as REPORT_PROVIDER=openai above) AND this separate
# opt-in flag — same double-gate reasoning as AI_RECOMMENDATION_ENABLED
# above: this makes more, and more expensive, OpenAI calls per request than
# the single classification call it replaces, and shouldn't silently
# activate for a key configured for something else. When unset (or the loop
# errors), both Copilot and Action Center refresh fall back to their
# existing fixed-list behavior.
# AGENTIC_ORCHESTRATION_ENABLED=true
# Which OpenAI model drives the tool-calling loop — defaults to gpt-4o-mini.
# AGENTIC_ORCHESTRATION_MODEL=gpt-4o-mini
# Max LLM decision rounds and max real agent invocations per session — tune
# these once real usage/cost data comes in. Defaults: 4 rounds, 10 tool calls
# (10 = today's total selectable-agent count, so worst case never exceeds the
# old "run everything" cost).
# AGENTIC_MAX_ROUNDS=4
# AGENTIC_MAX_TOOL_CALLS=10

# ── Growth Plan Narrative (optional, client-facing Milestones LLM pass) ──────
# One real LLM call per site, only when its Full Site Audit findings change,
# writing the "Your Growth Plan" narrative shown on Milestones (how our
# agents will grow this specific client, grounded in their own real audit
# findings). Requires a real ANTHROPIC_API_KEY or OPENAI_API_KEY (same vars
# as the daily-narrative feature above) AND this separate opt-in flag — same
# double-gate reasoning as AI_RECOMMENDATION_ENABLED/AGENTIC_ORCHESTRATION_ENABLED:
# shouldn't silently activate for a key configured for something else. When
# unset, Milestones simply omits this section — the existing projection
# charts render as before.
# GROWTH_PLAN_NARRATIVE_ENABLED=true

# ── GitHub PR automation (internal only, Action Center) ──────────────────────
# Fine-grained Personal Access Token used by server/implementers/ + server/github/
# to apply an approved Action Center draft as a real pull request against a
# site's own repo. Scope it to just that one repo, with Contents (read/write)
# and Pull requests (read/write) permissions — never broader. Which repo/env
# var a given site uses is configured per-site via `npm run connect-repo`, not
# here; this is just the token value itself. Without this set, "Apply Change"
# fails honestly (site has no repo configured / no PAT) — every other Action
# Center feature (generate, edit, approve, manual "Mark Implemented") keeps
# working normally.
# GITHUB_PAT=

# Optional, search-only: GitHub's Code Search REST API (/search/code) does
# NOT work with a fine-grained PAT — it silently returns 0 results instead of
# an auth error, rather than the classic-PAT-with-repo-scope it actually
# requires. GITHUB_PAT above can stay fine-grained/least-privilege for every
# other call (Contents, PRs, branches); set this to a classic PAT (repo
# scope) used ONLY by broken-link-fix's code-search fallback
# (server/github/client.js's searchCodeForString). Per-site override:
# `<site's github_pat_env_var>_SEARCH`, e.g. GITHUB_PAT_SEARCH.
# GITHUB_SEARCH_PAT=

# Secret shared with GitHub's webhook config on each site's repo (Settings →
# Webhooks → your webhook → Secret). Used to verify inbound POSTs to
# /api/webhooks/github really came from GitHub (server/routes/webhooks.js),
# so a merged PR can auto-flip its Action Center draft(s) to "implemented"
# without a human clicking "Check PR Status". Without this set, the webhook
# route fails closed (401) on every request — manual Check PR Status still
# works as before.
# GITHUB_WEBHOOK_SECRET=

# ── Deployment ─────────────────────────────────────────────────────────────────
# Public domain for Traefik routing (used in docker-compose labels).
ANALYTICS_DOMAIN=analytics.example.com
# Port the Node server listens on inside the container (default: 3002).
# API_PORT=3002

# ── Standalone MCP server (mcp-server/, own top-level folder) ───────────────────
# POST /api/mcp and the whole OAuth 2.1 surface (/oauth/*, /.well-known/*) run
# in their own process, on their own subdomain — the canonical public MCP
# endpoint for the Data Analyst Agent and any other MCP/OAuth client. Same
# repo/package.json/deploy pipeline as server/, just its own entrypoint
# (mcp-server/index.js) and its own Docker service — see docker-compose.yml's
# "analytics-mcp" service.
MCP_DOMAIN=mcp.example.com
# Port the standalone MCP process listens on inside its container (default: 3003).
# MCP_API_PORT=3003
# The dashboard's own origin — used only by the MCP process, to send an OAuth
# consent redirect (mcp-server/oauth-provider.js) back to the session-authed
# consent screen, which lives on the dashboard, not on MCP_DOMAIN.
DASHBOARD_ORIGIN=https://analytics.example.com
# Postgres pool size per process (server/db.js) — defaults to 10. The
# standalone MCP process overrides this smaller (e.g. 5) since it holds its
# own independent pool against the same DATABASE_URL as the main app.
# DB_POOL_MAX=10

# Base URL of the standalone data-analyst-agent/ Python service, reverse-
# proxied under this app at /data-agent/* (server/routes/data-agent.js) —
# reuses this domain instead of giving that service its own subdomain. In
# prod this is the sibling container's name (both attach to the shared
# "hosting" Docker network); locally it's wherever you're running that
# service's own uvicorn process directly.
# DATA_ANALYST_AGENT_INTERNAL_URL=http://127.0.0.1:8000

# Must equal that service's own ADMIN_API_KEY (data-analyst-agent/.env) —
# server/routes/dataAnalyst.js attaches it server-side as X-Admin-Key on
# every proxied /analyst request; the browser never sees it.
# DATA_ANALYST_AGENT_ADMIN_KEY=

# ── Optional overrides ─────────────────────────────────────────────────────────
# Set to true to skip the cron scheduler (useful for one-off script containers).
# DISABLE_CRON=true
# Set to true to skip the startup catch-up job.
# DISABLE_CATCHUP=true

# How many of content-integrity.js's up-to-100-page-per-run static fetches run
# at once against one tenant's host. "100 pages scanned per run" is deliberately
# NOT the same thing as "100 simultaneous requests" — this caps the latter.
# Lower it for a tenant host known to be sensitive to burst traffic.
# CONTENT_INTEGRITY_FETCH_CONCURRENCY=10
