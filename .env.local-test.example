# ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# Local test settings: sign-up, approval emails, sign-in codes, workspace and project creation,
# Connect with Google and Connect with GitHub.
#
# HOW TO USE:  cp .env.local-test.example .env      (then fill in the blanks below)
#
# This file holds NO secrets. Anything left blank has to be given to you separately (a password manager or a secure
# message, never a commit or a chat). Never put a real or shared database in DATABASE_URL: use a LOCAL one.
# ─────────────────────────────────────────────────────────────────────────────────────────────────────────

# ── Local database + server ──────────────────────────────────────────────────────────────────────────────
# A local Postgres, e.g.:  docker run -d --name superrank-dev-db -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=analytics -p 55432:5432 postgres:17-alpine
# then create the tables:  node server/migrations/run.js
DATABASE_URL=postgres://postgres:dev@localhost:55432/analytics
DB_SSL=off
# Any long random text:  openssl rand -base64 32
SESSION_SECRET=
# One port serves the app and the API (npm run dev). 5174 is the address registered for the GitHub sign-in.
API_PORT=5174
APP_BASE_URL=http://localhost:5174
# The staff site: the first site created by the migrations. Staff accounts belong to it (see the prompt).
COMPANY_SITE_ID=1
# Keep the scheduled jobs off on a developer machine.
DISABLE_CRON=true
DISABLE_CATCHUP=true

# ── Email: everything goes to YOUR address ───────────────────────────────────────────────────────────────
# Every email (sign-up received, staff notice, approval, sign-in code) is delivered to this one address, with the
# real recipient shown in the subject, so nobody else is ever emailed. Needs the SMTP_* lines below.
DEV_MAIL_ALL_TO=
# Also keep a copy of each email as a page in this folder (ignored by git). Works even without SMTP.
DEV_MAIL_OUTBOX=.local-mail
# localhost cannot be reached by a mail app, so the logo is read from the live site.
EMAIL_LOGO_URL=https://app.superrank.si/superrank-logo.png
# A mail account that can send (ask for these, or use your own). Leave blank to use the saved pages only.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL_FROM=

# ── Connect with Google (project popup, Google step) ─────────────────────────────────────────────────────
# Your own Google OAuth client (or the shared one, given to you), with this return address added to it:
#   http://localhost:5174/api/google/callback
GOOGLE_CONNECT_CLIENT_ID=
GOOGLE_CONNECT_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5174/api/google/callback
# Stores each person's Google sign-in safely. Any 32 random bytes:  openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# ── Connect with GitHub (project popup, GitHub step) ─────────────────────────────────────────────────────
# The "SuperRank" GitHub App. The App ID, Client ID and slug are not secret. The client secret and the private key
# are, and are given to you separately (the key as base64 on one line: base64 -i key.pem | tr -d '\n').
# The app must list http://localhost:5174/api/github/callback as a return address.
GITHUB_CONNECT_APP_ID=5493269
GITHUB_APP_CLIENT_ID=Iv23lifbsePJa8UGAvmi
GITHUB_APP_SLUG=superrank
GITHUB_APP_CLIENT_SECRET=
GITHUB_CONNECT_APP_PRIVATE_KEY_B64=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5174/api/github/callback
